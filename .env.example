# Root env reference for local development.
# Copy values into backend/.env and frontend/.env as needed.

# --- Backend ---
DB_URL=sqlite:///./portfolio.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
FRONTEND_ORIGIN_INTERNAL=http://localhost:5173
FRONTEND_ORIGIN_EXTERNAL=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Frontend ---
VITE_GOOGLE_CLIENT_ID=abc.apps.googleusercontent.com
VITE_FRONTEND_HOST=127.0.0.1
VITE_FRONTEND_PORT=5173
VITE_BACKEND_PORT=8000
VITE_API_BASE_INTERNAL=http://127.0.0.1:8000
VITE_API_BASE_EXTERNAL=http://localhost:8000
